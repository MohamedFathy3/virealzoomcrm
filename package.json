{
  "name": "viralzoom-erp",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "node scripts/with-tls.mjs next dev -H 0.0.0.0 -p 3000",
    "build": "prisma generate && next build",
    "start": "node scripts/with-tls.mjs next start -H 0.0.0.0 -p ${PORT:-3006}",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:push": "node scripts/with-tls.mjs prisma db push --skip-generate",
    "db:migrate": "node scripts/with-tls.mjs prisma migrate deploy",
    "db:seed": "node scripts/with-tls.mjs tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "jose": "^6.0.12",
    "lucide-react": "^0.468.0",
    "next": "^15.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@next/env": "15.5.29",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.32.0",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.3",
    "prisma": "^6.12.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
